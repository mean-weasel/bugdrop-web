# Required runtime configuration. Use a token scoped to D1 Read and D1 Write for this database.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-database-id
CLOUDFLARE_D1_API_TOKEN=replace-with-dedicated-d1-token
CRON_SECRET=replace-with-at-least-16-random-characters
MONITOR_HEARTBEAT_SECRET=replace-with-at-least-32-random-characters

# Optional target overrides
MONITOR_LANDING_URL=https://bugdrop.dev/
MONITOR_WIDGET_URL=https://bugdrop.neonwatty.workers.dev/widget.js
MONITOR_HEALTH_URL=https://bugdrop.neonwatty.workers.dev/api/health
MONITOR_GITHUB_CHECK_URL=https://bugdrop.neonwatty.workers.dev/api/check/mean-weasel/bugdrop-widget-test

# Optional generic alert webhook
MONITOR_ALERT_WEBHOOK_URL=https://alerts.example.com/bugdrop
MONITOR_ALERT_WEBHOOK_SECRET=replace-with-a-dedicated-webhook-secret

# Optional Resend email alerts; configure all three together
RESEND_API_KEY=re_replace-with-resend-key
MONITOR_ALERT_EMAIL_FROM=BugDrop Status <status@bugdrop.dev>
MONITOR_ALERT_EMAIL_TO=operator@example.com
